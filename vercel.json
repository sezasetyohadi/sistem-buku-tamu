{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "env": {
    "APP_MODE": "full",
    "NODE_ENV": "production"
  },
  "functions": {
    "src/app/**/*.ts": {
      "runtime": "@vercel/node@18"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "admin-sistem-buku-tamu.vercel.app"
        }
      ],
      "destination": "/admin"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "guest-sistem-buku-tamu.vercel.app"
        }
      ],
      "destination": "/guest"
    },
    {
      "source": "/((?!admin|guest|api|_next|favicon.ico).*)",
      "has": [
        {
          "type": "host",
          "value": "admin-sistem-buku-tamu.vercel.app"
        }
      ],
      "destination": "/admin"
    },
    {
      "source": "/((?!admin|guest|api|_next|favicon.ico).*)",
      "has": [
        {
          "type": "host",
          "value": "guest-sistem-buku-tamu.vercel.app"
        }
      ],
      "destination": "/guest"
    }
  ],
  "redirects": [
    {
      "source": "/guest/:path*",
      "has": [
        {
          "type": "host",
          "value": "admin-sistem-buku-tamu.vercel.app"
        }
      ],
      "destination": "/admin",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "has": [
        {
          "type": "host",
          "value": "guest-sistem-buku-tamu.vercel.app"
        }
      ],
      "destination": "/guest",
      "permanent": false
    }
  ]
}