# ===========================================
# DATABASE CONFIGURATION
# ===========================================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=your_database_name
DB_PORT=3306

# ===========================================
# DATABASE PERFORMANCE CONFIGURATION
# ===========================================
DB_CONNECTION_LIMIT=20
DB_QUEUE_LIMIT=0
DB_SSL=false
SLOW_QUERY_THRESHOLD=1000
QUERY_CACHE_TTL=300000

# ===========================================
# GUEST MODE CONFIGURATION
# ===========================================
NEXT_PUBLIC_APP_MODE_GUEST=guest
NEXT_PUBLIC_GUEST_URL=http://localhost:3000
NEXT_PUBLIC_GUEST_PORT=3000

# ===========================================
# ADMIN MODE CONFIGURATION
# ===========================================
NEXT_PUBLIC_APP_MODE_ADMIN=admin
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_PORT=3001

# ===========================================
# SMTP CONFIGURATION
# ===========================================
# Untuk Gmail, gunakan App Password, bukan password biasa
# Cara mendapatkan App Password: https://support.google.com/accounts/answer/185833
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# ===========================================
# JWT CONFIGURATION
# ===========================================
JWT_SECRET=your_very_long_and_secure_jwt_secret_key_here
# Make sure to change these secrets in production to strong, unpredictable values
# ===========================================

# ===========================================
# BASE URL CONFIGURATION FOR DIFFERENT MODES
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ===========================================
# DEPLOYMENT CONFIGURATION
# ===========================================
# Base URL untuk production deployment
# Ganti dengan domain yang sebenarnya saat deploy
NEXT_PUBLIC_BASE_URL=http://localhost:3001
# Contoh untuk production: NEXT_PUBLIC_BASE_URL=https://yourdomain.com
# ===========================================

# ===========================================
# CLOUDFLARE R2 CONFIGURATION
# ===========================================
CF_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=your_bucket_name
R2_PUBLIC_URL=https://pub-your_public_subdomain.r2.dev
DATABASE_URL=mysql://root:password@localhost:3306/database_name