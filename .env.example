DB_HOST=dbhost_address
DB_USER=user_name
DB_PASSWORD=password
DB_NAME=your_name
DB_PORT=port

# ===========================================
# DATABASE PERFORMANCE CONFIGURATION
# ===========================================
DB_CONNECTION_LIMIT=20
DB_QUEUE_LIMIT=0
DB_SSL=false
SLOW_QUERY_THRESHOLD=1000
QUERY_CACHE_TTL=300000

# ===========================================
# ADMIN MODE CONFIGURATION
# ===========================================
#APP_MODE=admin
#PORT=3001
#NEXT_PUBLIC_APP_MODE=admin
#NEXT_PUBLIC_API_URL=http://localhost:3001

# ===========================================
# GUEST MODE CONFIGURATION  
# ===========================================
#APP_MODE=guest
#PORT=3000
#NEXT_PUBLIC_APP_MODE=guest
#NEXT_PUBLIC_API_URL=http://localhost:3000

# ===========================================
# SMTP CONFIGURATION
# ===========================================
# Untuk Gmail, gunakan App Password, bukan password biasa
# Cara mendapatkan App Password: https://support.google.com/accounts/answer/185833
#SMTP_USER=your_email@gmail.com
#SMTP_PASSWORD=your_app_password
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_SECURE=false

# ===========================================
# JWT CONFIGURATION
# ===========================================
#JWT_SECRET=your_jwt_secret_key
# Make sure to change these secrets in production to strong, unpredictable values
# ===========================================