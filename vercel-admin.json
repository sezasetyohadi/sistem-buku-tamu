{
  "version": 2,
  "name": "buku-tamu-admin",
  "alias": ["admin-buku-tamu"],
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "build": {
    "env": {
      "APP_MODE": "admin",
      "NEXT_PUBLIC_APP_MODE": "admin"
    }
  },
  "env": {
    "APP_MODE": "admin",
    "NEXT_PUBLIC_APP_MODE": "admin"
  },
  "functions": {
    "src/app/api/**/*.ts": {
      "runtime": "nodejs18.x"
    }
  },
  "rewrites": [
    {
      "source": "/((?!admin|api|_next|favicon).*)",
      "destination": "/admin/$1"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/admin",
      "permanent": false
    }
  ]
}