{
  "name": "sistem-buku-tamu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:admin\" \"npm run dev:guest\"",
    "dev:single": "next dev --turbopack",
    "dev:admin": "cross-env APP_MODE=admin NEXT_PUBLIC_APP_MODE=admin next dev --turbopack -p 3001",
    "dev:guest": "cross-env APP_MODE=guest NEXT_PUBLIC_APP_MODE=guest next dev --turbopack -p 3000",
    "build": "npm run build:admin && npm run build:guest",
    "build:admin": "cross-env APP_MODE=admin NEXT_PUBLIC_APP_MODE=admin next build",
    "build:guest": "cross-env APP_MODE=guest NEXT_PUBLIC_APP_MODE=guest next build",
    "build:no-lint": "cross-env DISABLE_ESLINT=true next build",
    "start": "next start",
    "start:admin": "cross-env APP_MODE=admin NEXT_PUBLIC_APP_MODE=admin next start -p 3001",
    "start:guest": "cross-env APP_MODE=guest NEXT_PUBLIC_APP_MODE=guest next start -p 3000",
    "lint": "next lint",
    "lint:dev": "next lint --config eslint.config.dev.mjs",
    "lint:fix": "next lint --fix",
    "lint:fix:dev": "next lint --fix --config eslint.config.dev.mjs",
    "deploy:admin": "cross-env APP_MODE=admin NEXT_PUBLIC_APP_MODE=admin vercel --prod",
    "deploy:guest": "cross-env APP_MODE=guest NEXT_PUBLIC_APP_MODE=guest vercel --prod",
    "deploy:both": "npm run deploy:admin && npm run deploy:guest",
    "preview:admin": "cross-env APP_MODE=admin NEXT_PUBLIC_APP_MODE=admin vercel",
    "preview:guest": "cross-env APP_MODE=guest NEXT_PUBLIC_APP_MODE=guest vercel"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.888.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^7.0.1",
    "@types/validator": "^13.15.3",
    "bcrypt": "^6.0.0",
    "chart.js": "^4.5.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.1",
    "exceljs": "^4.4.0",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "mysql2": "^3.14.3",
    "next": "^16.4.6",
    "nodemailer": "^10.6.1",
    "react": "19.1.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "19.1.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.5.0",
    "tailwind-merge": "^3.3.1",
    "validator": "^13.15.15"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/estree": "^1.0.8",
    "@types/json-schema": "^7.0.15",
    "@types/json5": "^0.0.30",
    "@types/node": "^20.19.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/trusted-types": "^2.0.7",
    "concurrently": "^8.2.2",
    "critters": "^0.0.23",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "15.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.7.1",
    "typescript": "^5"
  }
}
